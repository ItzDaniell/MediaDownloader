<Window x:Class="MediaDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaDownloader"
        mc:Ignorable="d"
        Title="Media Downloader Pro • Enterprise Edition" 
        Height="720" Width="960" 
        MinHeight="660" MinWidth="860"
        Background="#0A0E17" 
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">

    <Window.Resources>
        <!-- Paleta de Colores Empresarial -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0E17"/>
        <SolidColorBrush x:Key="CardBg" Color="#121826"/>
        <SolidColorBrush x:Key="CardInnerBg" Color="#0B0F19"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1F2A3E"/>
        <SolidColorBrush x:Key="CardBorderHighlight" Color="#2E3E5B"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryBlueHover" Color="#3B82F6"/>
        <SolidColorBrush x:Key="PrimaryBluePressed" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextGray" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>

        <!-- Estilo: Botón Primario Corporativo -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0.0"/>
                        <GradientStop Color="#1D4ED8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="20,10"
                                BorderThickness="1"
                                BorderBrush="#3B82F6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0.0"/>
                                            <GradientStop Color="#2563EB" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo: Botón Secundario Corporativo -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#162032"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3850"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="7" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#223049"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#111927"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo: Botón Pequeño de Acción / Icono -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2438"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3952"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#263652"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#121A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo: TextBox Moderno -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#26344B"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="Background" Value="#0D1321"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#384C6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo: ComboBox Moderno Corporativo -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#26344B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot" 
                                                Background="#0B0F19" 
                                                BorderBrush="#26344B" 
                                                BorderThickness="1" 
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Flecha vectorial moderna -->
                                                <Path x:Name="arrow" 
                                                      Grid.Column="1" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                                      Fill="#94A3B8"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#3B82F6"/>
                                                <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="14,10,34,10" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="260">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#121826" 
                                            BorderThickness="1" 
                                            BorderBrush="#2A3850" 
                                            CornerRadius="8" 
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo: ProgressBar Moderno -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="BorderBrush" Value="#1E2A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" 
                                        HorizontalAlignment="Left" 
                                        CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563EB" Offset="0.0"/>
                                            <GradientStop Color="#60A5FA" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0A0E17">
        <Grid.RowDefinitions>
            <!-- Header Corporativo -->
            <RowDefinition Height="Auto"/>
            <!-- Área Principal / Cards -->
            <RowDefinition Height="*"/>
            <!-- Footer / Barra de Estado -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- HEADER CORPORATIVO                                             -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#101624" BorderBrush="#1B2436" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Identidad & Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icono Emblema -->
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0.0"/>
                                <GradientStop Color="#1D4ED8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" 
                              Fill="#FFFFFF" 
                              Width="20" Height="20" 
                              Stretch="Uniform" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MediaDownloader" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#F8FAFC" 
                                       VerticalAlignment="Center"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ENTERPRISE PRO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Suite autónoma de procesamiento y extracción multimedia" 
                                   FontSize="11" 
                                   Foreground="#64748B" 
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Badges de Estado del Motor (Portable & Hardware) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Motor Portable Activo" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#162032" BorderBrush="#26364E" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="FFmpeg v7 Portable" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#162032" BorderBrush="#26364E" BorderThickness="1" CornerRadius="14" Padding="10,5">
                        <TextBlock Text="yt-dlp Core" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- CONTENIDO PRINCIPAL / CARDS                                    -->
        <!-- ============================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,24">

                <!-- CARD 1: Entrada de URL y Detección Inteligente -->
                <Border Background="#121826" BorderBrush="#1F2A3E" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECURSO MULTIMEDIA" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="#38BDF8" 
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="Pega la URL directa del video, audio o hilo para procesar:" 
                                           FontSize="12" 
                                           Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- Badge de Plataforma Detectada -->
                            <Border x:Name="PlatformBadgeBorder" 
                                    Grid.Column="1" 
                                    Background="#1A2438" 
                                    BorderBrush="#283852" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="12,4" 
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="PlatformBadgeText" 
                                           Text="● Esperando enlace..." 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           Foreground="#94A3B8"/>
                            </Border>
                        </Grid>

                        <!-- Input + Botones de Acción (Pegar / Limpiar) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="UrlTextBox" 
                                     Grid.Column="0" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="44" 
                                     TextChanged="UrlTextBox_TextChanged"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"/>

                            <Button x:Name="PasteButton" 
                                    Grid.Column="1" 
                                    Style="{StaticResource ActionButtonStyle}" 
                                    Height="44" 
                                    Margin="0,0,8,0"
                                    Click="PasteButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 2h-4.18C14.4 0.84 13.3 0 12 0c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm7 18H5V4h2v3h10V4h2v16z" 
                                          Fill="#94A3B8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Pegar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="ClearButton" 
                                    Grid.Column="2" 
                                    Style="{StaticResource ActionButtonStyle}" 
                                    Height="44" 
                                    Click="ClearButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                          Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Limpiar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="✓ Soporte nativo para videos públicos, estados multimedia de X (Twitter) y YouTube sin login requerido." 
                                   FontSize="11" 
                                   Foreground="#64748B" 
                                   Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Formato & Directorio de Destino -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna Izquierda: Formato -->
                    <Border Grid.Column="0" Background="#121826" BorderBrush="#1F2A3E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="PARÁMETROS DE EXTRACCIÓN" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="#38BDF8" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Selecciona el formato de exportación:" 
                                       FontSize="12" 
                                       Foreground="#94A3B8" 
                                       Margin="0,0,0,12"/>

                            <ComboBox x:Name="FormatComboBox" Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="MP4 — Video de Alta Compatibilidad (H.264 / AAC)" IsSelected="True" Foreground="#F8FAFC"/>
                                <ComboBoxItem Content="MP3 — Audio Masterizado (192 kbps Transcodificado)" Foreground="#F8FAFC"/>
                            </ComboBox>

                            <TextBlock Text="ℹ️ MP4 genera un contenedor H.264 compatible con Smart TVs, móviles y software de edición." 
                                       FontSize="11" 
                                       Foreground="#64748B" 
                                       Margin="0,10,0,0" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Columna Derecha: Directorio de Destino -->
                    <Border Grid.Column="1" Background="#121826" BorderBrush="#1F2A3E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ALMACENAMIENTO LOCAL" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="#38BDF8" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Ubicación donde se guardarán los archivos:" 
                                       FontSize="12" 
                                       Foreground="#94A3B8" 
                                       Margin="0,0,0,12"/>

                            <Border Background="#0B0F19" BorderBrush="#26344B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                          Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PathTextBlock" 
                                               Grid.Column="1" 
                                               Text="C:\Users\...\Downloads\MediaDownloader" 
                                               FontSize="11" 
                                               Foreground="#CBD5E1" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowseFolderButton" 
                                        Grid.Column="0" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Height="36" 
                                        Margin="0,0,5,0"
                                        Click="BrowseFolderButton_Click">
                                    <TextBlock Text="Cambiar carpeta..."/>
                                </Button>
                                <Button x:Name="OpenFolderButton" 
                                        Grid.Column="1" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Height="36" 
                                        Margin="5,0,0,0"
                                        Click="OpenFolderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" 
                                              Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Abrir carpeta"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CARD 3: Botón Principal de Descarga -->
                <Button x:Name="DownloadButton" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Margin="0,0,0,18"
                        Click="DownloadButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" 
                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadButtonText" Text="Iniciar Descarga de Medios" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- CARD 4: Monitor de Procesamiento y Telemetría -->
                <Border Background="#121826" BorderBrush="#1F2A3E" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MONITOR DE OPERACIÓN" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="#94A3B8" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="ProgressPercentageTextBlock" 
                                       Grid.Column="1" 
                                       Text="0%" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#38BDF8"/>
                        </Grid>

                        <!-- Barra de Progreso -->
                        <ProgressBar x:Name="ProgressBar" 
                                     Style="{StaticResource ModernProgressBarStyle}" 
                                     Height="8" 
                                     Margin="0,0,0,12"/>

                        <!-- Registro de Estado / Consola -->
                        <Border Background="#090D15" BorderBrush="#1B2538" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <TextBlock x:Name="StatusTextBlock" 
                                       Text="Sistema listo. Pega una URL y haz clic en Iniciar Descarga." 
                                       FontSize="12" 
                                       Foreground="#94A3B8" 
                                       TextWrapping="Wrap" 
                                       LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- FOOTER / BARRA INFERIOR                                        -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="#0C111C" BorderBrush="#182234" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Arquitectura Portable 100% Autónoma • Sin dependencias globales del sistema" 
                           FontSize="11" 
                           Foreground="#64748B" 
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" 
                           Text="WPF .NET 8.0 • Engine Release 2026" 
                           FontSize="11" 
                           Foreground="#475569" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- MODAL OVERLAY DE RESPUESTA CON DISEÑO DE ALTO IMPACTO           -->
        <!-- ============================================================== -->
        <Grid x:Name="NotificationOverlay" 
              Grid.Row="0"
              Grid.RowSpan="3" 
              Background="#D9060A14" 
              Visibility="Collapsed"
              Panel.ZIndex="999">
            
            <Border HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Width="460"
                    Background="#111728" 
                    BorderBrush="#25354F" 
                    BorderThickness="1.5" 
                    CornerRadius="16" 
                    Padding="30,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" Color="#000000" Opacity="0.85" Direction="270" ShadowDepth="12"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Icono Circular con Resplandor / Glow -->
                    <Grid Width="74" Height="74" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border x:Name="ModalGlowBorder" CornerRadius="37" Background="#10B981" Opacity="0.25">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ModalGlowEffect" BlurRadius="25" Color="#10B981" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        
                        <Border x:Name="ModalIconCircle" CornerRadius="32" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="ModalIconGrad1" Color="#10B981" Offset="0.0"/>
                                    <GradientStop x:Name="ModalIconGrad2" Color="#059669" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path x:Name="ModalIconPath" 
                                  Data="M 9 16.2 L 4.8 12 L 3.4 13.4 L 9 19 L 21 7 L 19.6 5.6 Z" 
                                  Fill="#FFFFFF" 
                                  Stretch="Uniform" 
                                  Width="26" 
                                  Height="26" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Título Principal -->
                    <TextBlock x:Name="ModalTitleText" 
                               Text="¡Descarga Completada con Éxito!" 
                               FontSize="19" 
                               FontWeight="Bold" 
                               Foreground="#F8FAFC" 
                               TextAlignment="Center" 
                               Margin="0,0,0,6"/>

                    <!-- Etiqueta de Subtítulo -->
                    <TextBlock x:Name="ModalSubtitleText" 
                               Text="Extracción y procesamiento multimedia finalizados" 
                               FontSize="12" 
                               Foreground="#38BDF8" 
                               FontWeight="SemiBold" 
                               TextAlignment="Center" 
                               Margin="0,0,0,16"/>

                    <!-- Tarjeta con Descripción y Ruta -->
                    <Border Background="#090D17" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock x:Name="ModalMessageText" 
                                       Text="El archivo multimedia se procesó correctamente y está listo para ser utilizado." 
                                       FontSize="12.5" 
                                       Foreground="#94A3B8" 
                                       TextWrapping="Wrap" 
                                       LineHeight="19" 
                                       TextAlignment="Center"/>
                            
                            <!-- Contenedor de Ruta de Almacenamiento -->
                            <StackPanel x:Name="ModalPathContainer" Margin="0,12,0,0">
                                <Border Background="#121A2C" BorderBrush="#24344E" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                              Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ModalPathText" 
                                                   Grid.Column="1"
                                                   Text="C:\Users\...\Downloads\MediaDownloader" 
                                                   FontSize="11" 
                                                   Foreground="#CBD5E1" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Acciones / Botones -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ModalCol0" Width="*"/>
                            <ColumnDefinition x:Name="ModalCol1" Width="12"/>
                            <ColumnDefinition x:Name="ModalCol2" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Acción Primaria: Abrir Carpeta -->
                        <Button x:Name="ModalOpenFolderButton" 
                                Grid.Column="0" 
                                Click="ModalOpenFolderButton_Click" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="42">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" 
                                      Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Abrir Carpeta" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Aceptar / Cerrar -->
                        <Button x:Name="ModalCloseButton" 
                                Grid.Column="2" 
                                Click="ModalCloseButton_Click" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Height="42">
                            <TextBlock Text="Entendido" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
